# 仅作为配置清单。不得将真实密钥提交到 Git。
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://buyhksim:change-me@127.0.0.1:5432/buyhksim_v2
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGINS=http://127.0.0.1:3100,http://127.0.0.1:3101

# 使用至少 32 字节的独立随机值；生产环境不得复用。
JWT_ACCESS_SECRET=replace-with-32-byte-random-secret
JWT_REFRESH_SECRET=replace-with-another-32-byte-random-secret
PRICING_TOKEN_SECRET=replace-with-third-32-byte-random-secret
# 生成方式示例：openssl rand -base64 32
PII_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

PAYMENT_MODE=sandbox
PAYMENT_SANDBOX_WEBHOOK_SECRET=replace-with-random-sandbox-secret
ENABLE_WORKERS=false
AI_FEATURE_ENABLED=false
OPENAI_API_KEY=

# 构建前台和后台时注入；正式环境必须为 HTTPS API。
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1
NEXT_PUBLIC_ASSET_ORIGIN=
NEXT_PUBLIC_STATIC_EXPORT=false
NEXT_PUBLIC_ENABLE_DEMO=false
